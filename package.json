{
  "name": "biteback",
  "version": "1.0.0",
  "description": "Collective crypto disputes first; automatic merchant protection next.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@hono/node-server": "$@hono/node-server",
    "ethers": {
      "ws": "8.21.1"
    },
    "open-jsonrpc-provider": {
      "axios": "1.18.1",
      "ws": "8.21.1"
    },
    "protobufjs": "8.7.1",
    "undici": "6.28.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "setup:demo": "node --env-file=.env --import tsx scripts/setupDemo.ts",
    "policy:sign": "node --env-file=.env --import tsx scripts/signPolicy.ts",
    "claims:join": "node --env-file=.env --import tsx scripts/joinClaims.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "evidence:verify": "node --env-file=.env --import tsx scripts/verifyEvidence.ts",
    "demo:mint": "node --env-file=.env --import tsx scripts/mintDemoData.ts",
    "demo:run": "node --env-file=.env --import tsx scripts/runE2E.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-node": "^1.7.0",
    "@hashgraph/sdk": "^2.81.0",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@substreams/core": "^0.17.0",
    "ethers": "6.13.1",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
